PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
# Generate a secret with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Private uploaded files; relative paths resolve from backend/
FILE_STORAGE_DRIVER=filesystem
FILE_STORAGE_ROOT=./uploads
UPLOAD_MAX_FILE_SIZE_BYTES=104857600
# ffprobe from FFmpeg checks MP4 uploads: a command on PATH or an absolute path
FFPROBE_PATH=ffprobe

# Local development database
POSTGRES_DB=camioane
POSTGRES_USER=camioane
POSTGRES_PASSWORD=camioane_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://camioane:camioane_dev_password@127.0.0.1:5432/camioane?schema=public
