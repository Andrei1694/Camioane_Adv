generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  ADMIN
  OPERATOR
  DRIVER
  USER
}

model Role {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      RoleName  @unique
  startDate DateTime  @default(now()) @db.Timestamptz(3)
  /// A null end date means the role does not expire.
  endDate   DateTime? @db.Timestamptz(3)
  activ     Boolean   @default(true)
  users     User[]
}

enum CreditPurchaseStatus {
  PENDING
  PAID
  FAILED
  CANCELED
}

enum CreditTransactionType {
  PURCHASE
  ADJUSTMENT
  CAMPAIGN_DEBIT
  REFUND
}

model User {
  id                        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                     String              @unique
  /// Stores a password hash, never a plaintext password.
  password                  String
  roleId                    String              @db.Uuid
  role                      Role                @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessionVersion            Int                 @default(0)
  /// Cached sum of this user's credit ledger. Only applyCreditChange changes it.
  creditBalance             Int                 @default(0)
  avatar                    UserAvatar?
  files                     UploadedFile[]
  creditPurchases           CreditPurchase[]    @relation("CreditPurchaseUser")
  settledCreditPurchases    CreditPurchase[]    @relation("CreditPurchaseSettler")
  creditTransactions        CreditTransaction[] @relation("CreditTransactionUser")
  createdCreditTransactions CreditTransaction[] @relation("CreditTransactionCreator")

  @@index([roleId])
}

/// A user's profile picture. The API re-encodes every upload, so the stored
/// object is never the uploaded file itself.
model UserAvatar {
  userId          String   @id @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storageProvider String
  storageKey      String
  mimeType        String
  size            Int
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  @@unique([storageProvider, storageKey])
}

model UploadedFile {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId         String?  @db.Uuid
  owner           User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  storageProvider String
  storageKey      String
  originalName    String
  mimeType        String
  size            Int
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@unique([storageProvider, storageKey])
  @@index([ownerId, createdAt, id])
  @@index([createdAt, id])
}

/// A request to buy credits with money. Credits reach the balance only through
/// the PURCHASE ledger row written when the purchase is confirmed as paid.
model CreditPurchase {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Null after the account is deleted; the financial record is kept.
  userId            String?              @db.Uuid
  user              User?                @relation("CreditPurchaseUser", fields: [userId], references: [id], onDelete: SetNull)
  credits           Int
  /// Price per credit in the currency's minor unit, snapshotted at purchase time.
  unitPriceMinor    Int
  amountMinor       Int
  currency          String               @db.Char(3)
  status            CreditPurchaseStatus @default(PENDING)
  /// "manual" while admins confirm payments; the card processor's name later.
  provider          String?
  /// The admin's payment reference, or the processor's payment ID later.
  providerPaymentId String?
  settledById       String?              @db.Uuid
  settledBy         User?                @relation("CreditPurchaseSettler", fields: [settledById], references: [id], onDelete: SetNull)
  settledAt         DateTime?            @db.Timestamptz(3)
  createdAt         DateTime             @default(now()) @db.Timestamptz(3)
  transaction       CreditTransaction?

  @@unique([provider, providerPaymentId])
  @@index([userId, createdAt, id])
  @@index([status, createdAt, id])
}

/// A truck in the fleet. Deactivate it instead of deleting it once other records reference it.
model Car {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Uppercase letters and digits only; the API strips spaces and hyphens.
  plate     String   @unique
  active    Boolean  @default(true)
  info      CarInfo?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

/// Descriptive details of a car; at most one row per car.
model CarInfo {
  carId String @id @db.Uuid
  car   Car    @relation(fields: [carId], references: [id], onDelete: Cascade)
  make  String
  model String
  year  Int
}

/// Append-only credit ledger. Corrections are new ADJUSTMENT rows, never edits.
model CreditTransaction {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Null after the account is deleted; the financial record is kept.
  userId       String?               @db.Uuid
  user         User?                 @relation("CreditTransactionUser", fields: [userId], references: [id], onDelete: SetNull)
  /// Positive adds credits, negative removes them; never zero.
  amount       Int
  balanceAfter Int
  type         CreditTransactionType
  /// Unique so one purchase can credit the balance only once.
  purchaseId   String?               @unique @db.Uuid
  purchase     CreditPurchase?       @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  createdById  String?               @db.Uuid
  createdBy    User?                 @relation("CreditTransactionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  note         String?
  createdAt    DateTime              @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt, id])
}
