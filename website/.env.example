# Public address for the "Plan a campaign" and "Email us" links. Builds fail without it;
# development falls back to hello@example.com. Everything here ships to the browser.
VITE_CONTACT_EMAIL=

# Backend API base URL (or a same-origin proxy path) for src/lib/api.ts. Development falls back
# to http://localhost:3000; production builds have no fallback, so set it when building.
VITE_API_BASE_URL=http://localhost:3000
