{
	admin off
	persist_config off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "frame-ancestors 'none'"
	}

	handle /assets/* {
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@appPages path /login /login/ /account /account/ /demo-map-hero /demo-map-hero/
	handle @appPages {
		header Cache-Control no-cache
		rewrite * /index.html
		file_server
	}

	handle {
		header Cache-Control no-cache
		file_server
	}
}
