{
  "name": "camioane-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express API for Camioane App",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "concurrently --kill-others --names server,types \"npm run dev:server\" \"npm run typecheck:watch\"",
    "dev:server": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch --preserveWatchOutput",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 --experimental-test-module-mocks tests/*.test.ts",
    "test:coverage": "node --env-file-if-exists=.env --test --test-concurrency=1 --experimental-test-module-mocks --experimental-test-coverage --test-coverage-include=src/**/*.ts --test-coverage-exclude=src/generated/** --test-coverage-lines=100 tests/*.test.ts",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:check": "node --env-file-if-exists=.env src/scripts/check-db.ts",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "admin:bootstrap": "node --env-file-if-exists=.env src/scripts/bootstrap-admin.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "file-type": "^22.3.0",
    "jose": "^6.2.15",
    "multer": "^2.5.0",
    "pino": "^10.4.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "prisma": "^7.10.1",
    "typescript": "^7.0.2"
  }
}
